# =============================================================================
# DISATTIVATO. Template per il passaggio futuro all'account Apple a pagamento.
#
# GitHub ignora questo file finché ha estensione ".disabled".
# Per attivarlo: rinominarlo in testflight.yml e configurare i Secrets
# elencati sotto (nelle impostazioni della repo, mai nel codice).
#
# Secrets richiesti (App Store Connect API key + certificato di distribuzione):
#   ASC_KEY_ID            ID della chiave API App Store Connect (es. ABC123DEFG)
#   ASC_ISSUER_ID         Issuer ID (UUID) da App Store Connect > Users and Access > Integrations
#   ASC_KEY_P8_BASE64     Contenuto del file AuthKey_XXXX.p8 codificato in base64
#   APPLE_TEAM_ID         Team ID (10 caratteri) dell'account sviluppatore
#   DIST_CERT_P12_BASE64  Certificato "Apple Distribution" esportato come .p12, in base64
#   DIST_CERT_PASSWORD    Password del .p12
#
# Il profilo di provisioning viene scaricato da xcodebuild stesso grazie a
# -allowProvisioningUpdates + chiave API (nessun profilo da committare).
# =============================================================================
name: testflight

on:
  workflow_dispatch:
    inputs:
      app:
        description: App folder under apps/
        required: true
        default: LTIDI

env:
  XCODE_VERSION: "16.4"

jobs:
  testflight:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4

      - uses: ./.github/actions/setup-xcode
        with:
          xcode-version: ${{ env.XCODE_VERSION }}
          app: ${{ inputs.app }}

      - name: Import distribution certificate into a temporary keychain
        env:
          DIST_CERT_P12_BASE64: ${{ secrets.DIST_CERT_P12_BASE64 }}
          DIST_CERT_PASSWORD: ${{ secrets.DIST_CERT_PASSWORD }}
        run: |
          set -euo pipefail
          KEYCHAIN="$RUNNER_TEMP/ci.keychain-db"
          KEYCHAIN_PASSWORD=$(uuidgen)
          echo "$DIST_CERT_P12_BASE64" | base64 --decode > "$RUNNER_TEMP/dist.p12"
          security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
          security set-keychain-settings -lut 21600 "$KEYCHAIN"
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
          security import "$RUNNER_TEMP/dist.p12" -P "$DIST_CERT_PASSWORD" -A \
            -t cert -f pkcs12 -k "$KEYCHAIN"
          security set-key-partition-list -S apple-tool:,apple: -k "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
          security list-keychain -d user -s "$KEYCHAIN"
          rm -f "$RUNNER_TEMP/dist.p12"

      - name: Write App Store Connect API key
        env:
          ASC_KEY_P8_BASE64: ${{ secrets.ASC_KEY_P8_BASE64 }}
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
        run: |
          set -euo pipefail
          mkdir -p "$HOME/private_keys"
          echo "$ASC_KEY_P8_BASE64" | base64 --decode > "$HOME/private_keys/AuthKey_${ASC_KEY_ID}.p8"
          echo "ASC_KEY_PATH=$HOME/private_keys/AuthKey_${ASC_KEY_ID}.p8" >> "$GITHUB_ENV"

      - name: Archive (signed, automatic signing via API key)
        working-directory: apps/${{ inputs.app }}
        env:
          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
        run: |
          set -euo pipefail
          # Build number = run number so every upload is unique on TestFlight.
          xcodebuild archive \
            -project "${{ inputs.app }}.xcodeproj" \
            -scheme "${{ inputs.app }}" \
            -configuration Release \
            -destination "generic/platform=iOS" \
            -archivePath "build/${{ inputs.app }}.xcarchive" \
            -allowProvisioningUpdates \
            -authenticationKeyPath "$ASC_KEY_PATH" \
            -authenticationKeyID "$ASC_KEY_ID" \
            -authenticationKeyIssuerID "$ASC_ISSUER_ID" \
            CODE_SIGN_STYLE=Automatic \
            DEVELOPMENT_TEAM="$APPLE_TEAM_ID" \
            CURRENT_PROJECT_VERSION="${{ github.run_number }}" \
            | xcbeautify --renderer github-actions

      - name: Export .ipa for App Store Connect
        working-directory: apps/${{ inputs.app }}
        env:
          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
        run: |
          set -euo pipefail
          cat > build/ExportOptions.plist <<PLIST
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0"><dict>
            <key>method</key><string>app-store-connect</string>
            <key>destination</key><string>upload</string>
            <key>teamID</key><string>${APPLE_TEAM_ID}</string>
            <key>signingStyle</key><string>automatic</string>
            <key>uploadSymbols</key><true/>
          </dict></plist>
          PLIST
          xcodebuild -exportArchive \
            -archivePath "build/${{ inputs.app }}.xcarchive" \
            -exportOptionsPlist build/ExportOptions.plist \
            -exportPath build/export \
            -allowProvisioningUpdates \
            -authenticationKeyPath "$ASC_KEY_PATH" \
            -authenticationKeyID "$ASC_KEY_ID" \
            -authenticationKeyIssuerID "$ASC_ISSUER_ID" \
            | xcbeautify --renderer github-actions

      - name: Cleanup secrets from runner
        if: always()
        run: |
          rm -rf "$HOME/private_keys"
          security delete-keychain "$RUNNER_TEMP/ci.keychain-db" || true
